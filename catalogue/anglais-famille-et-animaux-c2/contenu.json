  "intro": "On apprend les mots de la famille, des animaux et de la classe.",
  "niveaux": [
    {
      "titre": "Mots utiles",
      "niveau": "pour démarrer",
      "paragraphes": [
        "**Mother** (mère), **father** (père), **sister** (sœur), **brother** (frère), **grandmother**, **grandfather**. Animaux : **dog** (chien), **cat** (chat), **bird** (oiseau), **fish** (poisson), **horse** (cheval). Classe : **book**, **pen**, **bag**, **table**."
      ],
      "exemple": {
        "titre": "Exemple",
        "etapes": [
          "My mother.",
          "A red bag.",
          "A black cat."
        ]
      },
      "aRetenir": "My = mon, ma, mes."
    },
    {
      "titre": "Faire des phrases",
      "niveau": "CE1 / CE2",
      "paragraphes": [
        "**I have** + nom : « I have a dog. » (j'ai un chien). **It is** + adjectif : « It is big. » **I like** + nom : « I like cats. » (j'aime les chats). Pour demander : « Do you have a cat ? »"
      ],
      "exemple": {
        "titre": "Exemple : parler de sa famille",
        "etapes": [
          "I have a sister.",
          "My sister is nine.",
          "I like my family."
        ]
      },
      "aRetenir": "I have = j'ai."
    }
  ],
  "application": {
    "intro": "Réponds à chaque question, puis lis la correction.",
