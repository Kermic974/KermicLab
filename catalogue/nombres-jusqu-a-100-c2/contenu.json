  "intro": "Avec les chiffres de 0 à 9, on peut écrire tous les nombres jusqu'à 100 et plus.",
  "niveaux": [
    {
      "titre": "Compter et regrouper",
      "niveau": "pour démarrer",
      "paragraphes": [
        "Pour compter beaucoup d'objets, on fait des paquets de 10. Un paquet de 10, c'est **une dizaine**. Les objets seuls, ce sont des **unités**.",
        "Dans 34, il y a 3 dizaines et 4 unités : 30 + 4 = 34."
      ],
      "exemple": {
        "titre": "Exemple : 27 billes",
        "etapes": [
          "Je fais 2 paquets de 10 billes.",
          "Il me reste 7 billes seules.",
          "27, c'est 2 dizaines et 7 unités."
        ]
      },
      "aRetenir": "Une dizaine = 10 unités."
    },
    {
      "titre": "Lire et écrire les nombres",
      "niveau": "CP",
      "paragraphes": [
        "Le chiffre de gauche dit combien de dizaines, le chiffre de droite combien d'unités. 52 se lit « cinquante-deux » : 5 dizaines et 2 unités.",
        "Après 99 vient **100** : cent. 10 dizaines font 100."
      ],
      "exemple": {
        "titre": "Exemple : 68",
        "etapes": [
          "6 dizaines = 60.",
          "8 unités = 8.",
          "60 + 8 = 68 : soixante-huit."
        ]
      },
      "aRetenir": "Le premier chiffre compte les dizaines."
    }
  ],
  "application": {
    "intro": "Réponds à chaque question, puis lis la correction.",
    "exercices": [
