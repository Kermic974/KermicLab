      "titre": "Pièces et billets",
      "niveau": "pour démarrer",
      "paragraphes": [
        "Il y a des pièces de 1, 2, 5, 10, 20, 50 centimes, de 1 € et 2 €, et des billets de 5, 10, 20, 50 € et plus. 1 € = 100 centimes.",
        "Pour payer, on additionne les pièces : 2 € + 1 € + 50 c = 3 € 50."
      ],
      "exemple": {
        "titre": "Exemple",
        "etapes": [
          "Un bonbon coûte 20 c.",
          "Je donne 2 pièces de 10 c.",
          "10 + 10 = 20 : c'est juste."
        ]
      },
      "aRetenir": "1 € = 100 centimes."
    },
    {
      "titre": "Rendre la monnaie",
      "niveau": "CE1 / CE2",
      "paragraphes": [
        "Pour **rendre la monnaie**, on complète le prix jusqu'à la somme donnée. Je paie un livre de 7 € avec un billet de 10 € : on me rend 3 €, car 7 + 3 = 10.",
        "On peut aussi calculer 10 − 7 = 3."
      ],
      "exemple": {
        "titre": "Exemple",
        "etapes": [
          "Prix : 6 €.",
          "Je donne 10 €.",
          "On me rend 4 €."
        ]
      },
      "aRetenir": "Complète jusqu'à la somme donnée."
    }
