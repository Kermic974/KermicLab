    "etapes": [
      {
        "type": "nombre",
        "question": "Combien de biscuits te reste-t-il ?",
        "reponse": 15,
        "indices": [
          "24 − 4 = 20, puis 20 − 5 = 15."
        ],
        "solution": "24 − 9 = 15.",
        "titre": "Exercice 1"
      },
      {
        "type": "nombre",
        "question": "Il t'en manque combien pour avoir 20 biscuits ?",
        "reponse": 5,
        "indices": [
          "Cherche ce qui manque."
        ],
        "solution": "20 − 15 = 5.",
        "titre": "Exercice 2"
      }
