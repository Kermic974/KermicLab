{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kermiclab.online/s6/perimetre-migration.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "specificationVersion", "sourceRevision", "entries"],
  "properties": {
    "formatVersion": { "const": 1 },
    "specificationVersion": { "const": "1.0.1" },
    "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}(?![\\s\\S])" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "discipline", "version", "sources", "allowedTargets"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])" },
          "kind": { "enum": ["fiche", "lab"] },
          "discipline": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])" },
          "version": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])" },
          "sources": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["path", "sha256LF"],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?:catalogue|Sample/lab|src/pedagogy)/[A-Za-z0-9._/-]+(?![\\s\\S])",
                  "not": { "pattern": "(^|/)\\.{1,2}(/|$)|//" }
                },
                "sha256LF": { "type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])" }
              }
            }
          },
          "allowedTargets": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "$ref": "https://schemas.kermiclab.online/s4/primitives.schema.json#/$defs/objet" }
          }
        }
      }
    }
  }
}
