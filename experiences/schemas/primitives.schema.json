{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kermiclab.online/s6/primitives.schema.json",
  "$defs": {
    "texte": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "id": {
      "type": "string",
      "pattern": "^experience\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "path": {
      "type": "string",
      "pattern": "^(?:catalogue|Sample/lab|src/pedagogy|docs)/[A-Za-z0-9._/-]+(?![\\s\\S])",
      "not": {
        "pattern": "(^|/)\\.{1,2}(/|$)|//"
      }
    },
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "anchor"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?:catalogue|Sample/lab|src/pedagogy|docs)/[A-Za-z0-9._/-]+(?![\\s\\S])",
          "not": {
            "pattern": "(^|/)\\.{1,2}(/|$)|//"
          }
        },
        "anchor": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9._:-]*(?![\\s\\S])"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "anchor",
        "format"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?:catalogue|Sample/lab|src/pedagogy|docs)/[A-Za-z0-9._/-]+(?![\\s\\S])",
          "not": {
            "pattern": "(^|/)\\.{1,2}(/|$)|//"
          }
        },
        "anchor": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9._:-]*(?![\\s\\S])"
        },
        "format": {
          "enum": [
            "catalogue-json",
            "html",
            "module-data"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "catalogue-json"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^catalogue/[a-z0-9-]+/contenu\\.json(?![\\s\\S])"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "html"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?:catalogue/[a-z0-9-]+/page(?:\\.[a-z]+)?|Sample/lab/[a-z0-9-]+)\\.html(?![\\s\\S])"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "module-data"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?:src/pedagogy|catalogue/[a-z0-9-]+)/[A-Za-z0-9._/-]+\\.m?js(?![\\s\\S])"
              }
            }
          }
        }
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^experience\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "references"
      ],
      "properties": {
        "type": {
          "enum": [
            "editorial",
            "legacy-v0"
          ]
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "primitives.schema.json#/$defs/documentRef"
          }
        },
        "migration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "slug",
            "revision",
            "sourcePaths"
          ],
          "properties": {
            "slug": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}(?![\\s\\S])"
            },
            "sourcePaths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(?:catalogue|Sample/lab|src/pedagogy|docs)/[A-Za-z0-9._/-]+(?![\\s\\S])",
                "not": {
                  "pattern": "(^|/)\\.{1,2}(/|$)|//"
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "legacy-v0"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "migration"
            ]
          },
          "else": {
            "not": {
              "required": [
                "migration"
              ]
            }
          }
        }
      ]
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2}(?:-[A-Z]{2})?(?![\\s\\S])"
        },
        "reading": {
          "enum": [
            "standard",
            "simplified"
          ]
        },
        "duration": {
          "enum": [
            "short",
            "standard",
            "extended"
          ]
        },
        "presentation": {
          "enum": [
            "standard",
            "text"
          ]
        },
        "navigation": {
          "enum": [
            "standard",
            "keyboard"
          ]
        },
        "response": {
          "enum": [
            "standard",
            "keyboard"
          ]
        }
      },
      "minProperties": 1
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modalities",
        "alternatives"
      ],
      "properties": {
        "modalities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "text",
              "visual",
              "audio",
              "keyboard",
              "pointer",
              "motion",
              "webgl"
            ]
          }
        },
        "alternatives": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "modality",
              "source"
            ],
            "properties": {
              "modality": {
                "enum": [
                  "text",
                  "visual",
                  "audio",
                  "keyboard",
                  "pointer",
                  "motion",
                  "webgl"
                ]
              },
              "source": {
                "$ref": "primitives.schema.json#/$defs/source"
              }
            }
          }
        },
        "review": {
          "$ref": "primitives.schema.json#/$defs/documentRef"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "date",
        "version",
        "scope"
      ],
      "properties": {
        "source": {
          "$ref": "primitives.schema.json#/$defs/documentRef"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}(?![\\s\\S])"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "scope": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "content",
              "targets",
              "accessibility"
            ]
          },
          "maxItems": 3
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "prompt",
        "expected"
      ],
      "properties": {
        "format": {
          "enum": [
            "qcm",
            "number",
            "action"
          ]
        },
        "prompt": {
          "$ref": "primitives.schema.json#/$defs/source"
        },
        "expected": {
          "$ref": "primitives.schema.json#/$defs/source"
        },
        "hints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "primitives.schema.json#/$defs/source"
          }
        },
        "feedback": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "primitives.schema.json#/$defs/source"
          }
        },
        "actions": {
          "$ref": "primitives.schema.json#/$defs/source"
        },
        "parameters": {
          "$ref": "primitives.schema.json#/$defs/source"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "action"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "required": [
              "actions"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "actions"
                  ]
                },
                {
                  "required": [
                    "parameters"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
