{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kermiclab.online/s6/lab.schema.json",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "lab"
        },
        "parameters": {
          "$ref": "primitives.schema.json#/$defs/source"
        },
        "interactions": {
          "$ref": "primitives.schema.json#/$defs/source"
        },
        "limits": {
          "$ref": "primitives.schema.json#/$defs/source"
        }
      },
      "required": [
        "type",
        "components",
        "sources",
        "parameters",
        "interactions",
        "limits"
      ]
    }
  ],
  "unevaluatedProperties": false
}
