{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kermiclab.online/s6/exercise.schema.json",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "exercise"
        },
        "components": false,
        "task": {
          "$ref": "primitives.schema.json#/$defs/task"
        }
      },
      "required": [
        "type",
        "sources",
        "task"
      ]
    }
  ],
  "unevaluatedProperties": false
}
