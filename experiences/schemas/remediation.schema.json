{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kermiclab.online/s6/remediation.schema.json",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "remediation"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "type",
        "components",
        "rationale"
      ]
    }
  ],
  "unevaluatedProperties": false
}
