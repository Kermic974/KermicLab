{
  "name": "trigolab",
  "version": "0.0.1",
  "private": true,
  "description": "Kermiclab MVP – agent conversationnel qui sert des pages HTML pédagogiques autonomes.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "node scripts/lint.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "test:captures": "KERMICLAB_CAPTURES=captures node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "ci": "npm run lint && npm run build && npm run check:pages && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.5.0",
    "jose": "6.2.15"
  },
  "devDependencies": {
    "wrangler": "4.157.0"
  }
}
