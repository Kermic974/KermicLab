{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kermiclab.online/referentiel/metiers.schema.json",
  "title": "Espace Métiers — format v2",
  "description": "Forme de referentiel/metiers-v0.json (ADR 0041, 0042 et 0045, chantier docs/chantiers/metiers.md). La cohérence entre éléments (identifiants connus, notions du référentiel, unicité ONISEP, contextes de travail et métiers proches connus) est vérifiée par verifierMetiers (web/metiers.js).",
  "type": "object",
  "required": [
    "version",
    "source",
    "categories",
    "disciplines",
    "metiers"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 2
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "libelle",
          "couleur"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/identifiant"
          },
          "libelle": {
            "type": "string",
            "minLength": 1
          },
          "couleur": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        }
      }
    },
    "disciplines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "nom",
          "savoirFaire",
          "notions",
          "correspondance"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/identifiant"
          },
          "nom": {
            "type": "string",
            "minLength": 1
          },
          "savoirFaire": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^notion\\.[a-z0-9-]+\\.[a-z0-9-]+$"
            }
          },
          "correspondance": {
            "$ref": "#/$defs/statut"
          },
          "relue": {
            "$ref": "#/$defs/date"
          }
        }
      }
    },
    "metiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "nom",
          "categorie",
          "disciplines",
          "gestes",
          "contexte",
          "correspondance"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/identifiant"
          },
          "nom": {
            "type": "string",
            "minLength": 1
          },
          "categorie": {
            "$ref": "#/$defs/identifiant"
          },
          "disciplines": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/identifiant"
            }
          },
          "gestes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "contexte": {
            "type": "string",
            "minLength": 1
          },
          "correspondance": {
            "$ref": "#/$defs/statut"
          },
          "relue": {
            "$ref": "#/$defs/date"
          },
          "onisep": {
            "type": "string",
            "pattern": "^MET\\.\\d+$"
          },
          "rome": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-N]\\d{4}$"
            }
          },
          "niveauAcces": {
            "enum": [
              "sans-diplome",
              "cap",
              "bac",
              "bac+1",
              "bac+2",
              "bac+3",
              "bac+4",
              "bac+5",
              "bac+6",
              "bac+7",
              "bac+8",
              "bac+9"
            ]
          },
          "domaines": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "synonymes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "contextes": {
            "type": "array",
            "description": "Contextes de travail du ROME 4.0 (identifiants de contextesTravail), dérivés par npm run import:rome.",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^\\d+$"
            }
          },
          "transitions": {
            "type": "array",
            "description": "Métier de la transition écologique (emploi vert ou stratégique du ROME) ou numérique.",
            "uniqueItems": true,
            "items": {
              "enum": [
                "ecologique",
                "numerique"
              ]
            }
          },
          "proches": {
            "type": "array",
            "description": "Métiers du référentiel atteints par les mobilités du ROME 4.0, 5 au plus.",
            "uniqueItems": true,
            "maxItems": 5,
            "items": {
              "$ref": "#/$defs/identifiant"
            }
          },
          "fap": {
            "type": "string",
            "description": "Métier de l’enquête BMO de France Travail (code FAP 2021), choisi à la main : rattachement à relire.",
            "pattern": "^[A-Z][0-9A-Z][A-Z]\\d{2}$"
          },
          "perspectives": {
            "type": "object",
            "description": "Perspectives de recrutement dérivées de l’enquête BMO (npm run import:bmo), France entière ; rattachement par le champ fap du métier ou par sa famille ROME (referentiel/regles-bmo.json).",
            "required": [
              "annee",
              "groupe",
              "projets",
              "partDifficile",
              "partSaisonnier",
              "palier"
            ],
            "additionalProperties": false,
            "properties": {
              "annee": {
                "type": "integer",
                "minimum": 2000
              },
              "groupe": {
                "type": "string",
                "minLength": 1
              },
              "projets": {
                "type": "integer",
                "minimum": 0
              },
              "partDifficile": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "partSaisonnier": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "palier": {
                "enum": [
                  "faible",
                  "moyen",
                  "fort"
                ]
              },
              "origine": {
                "enum": [
                  "metier",
                  "famille"
                ],
                "description": "metier : champ fap du métier ; famille : table referentiel/regles-bmo.json (famille ROME)."
              }
            }
          },
          "marche": {
            "type": "object",
            "description": "Tension de recrutement (API Marché du travail de France Travail, niveau France), dérivée par npm run import:marche : tranche de 1 (très faible) à 5 (très élevée).",
            "required": [
              "tension",
              "periode"
            ],
            "additionalProperties": false,
            "properties": {
              "tension": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "periode": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "contextesTravail": {
      "type": "array",
      "description": "Dictionnaire des contextes de travail du ROME 4.0 utilisés par les métiers (France Travail, Licence Ouverte 2.0).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "libelle",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "libelle": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "description": "Bases de données sources dont dérivent des champs (attribution exigée par leur licence).",
      "items": {
        "type": "object",
        "required": [
          "nom",
          "producteur",
          "licence",
          "url",
          "date"
        ],
        "additionalProperties": false,
        "properties": {
          "nom": {
            "type": "string",
            "minLength": 1
          },
          "producteur": {
            "type": "string",
            "minLength": 1
          },
          "licence": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "date": {
            "$ref": "#/$defs/date"
          },
          "champs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identifiant": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "statut": {
      "enum": [
        "v5",
        "proposition",
        "validee"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
