{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kermiclab.online/referentiel/metiers.schema.json",
  "title": "Espace Métiers — format v2",
  "description": "Forme de referentiel/metiers-v0.json (ADR 0041, chantier docs/chantiers/metiers.md). La cohérence entre éléments (identifiants connus, notions du référentiel, unicité ONISEP) est vérifiée par verifierMetiers (web/metiers.js).",
  "type": "object",
  "required": ["version", "source", "categories", "disciplines", "metiers"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 2 },
    "source": { "type": "string", "minLength": 1 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "libelle", "couleur"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/identifiant" },
          "libelle": { "type": "string", "minLength": 1 },
          "couleur": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        }
      }
    },
    "disciplines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "nom", "savoirFaire", "notions", "correspondance"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/identifiant" },
          "nom": { "type": "string", "minLength": 1 },
          "savoirFaire": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "notions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^notion\\.[a-z0-9-]+\\.[a-z0-9-]+$" } },
          "correspondance": { "$ref": "#/$defs/statut" },
          "relue": { "$ref": "#/$defs/date" }
        }
      }
    },
    "metiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "nom", "categorie", "disciplines", "gestes", "contexte", "correspondance"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/identifiant" },
          "nom": { "type": "string", "minLength": 1 },
          "categorie": { "$ref": "#/$defs/identifiant" },
          "disciplines": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifiant" } },
          "gestes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "contexte": { "type": "string", "minLength": 1 },
          "correspondance": { "$ref": "#/$defs/statut" },
          "relue": { "$ref": "#/$defs/date" },
          "onisep": { "type": "string", "pattern": "^MET\\.\\d+$" },
          "rome": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-N]\\d{4}$" } },
          "niveauAcces": { "enum": ["cap", "bac", "bac+2", "bac+3", "bac+5", "bac+8"] },
          "domaines": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  },
  "$defs": {
    "identifiant": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "statut": { "enum": ["v5", "proposition", "validee"] },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
