{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kermiclab.online/s4/stage.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "curriculum",
    "stageType",
    "code",
    "label",
    "status",
    "version"
  ],
  "properties": {
    "id": {
      "$ref": "primitives.schema.json#/$defs/stage"
    },
    "type": {
      "const": "stage"
    },
    "curriculum": {
      "$ref": "primitives.schema.json#/$defs/curriculum"
    },
    "stageType": {
      "enum": [
        "cycle",
        "grade"
      ]
    },
    "code": {
      "enum": [
        "cycle-2",
        "cycle-3",
        "cycle-4",
        "seconde",
        "premiere",
        "terminale"
      ]
    },
    "label": {
      "$ref": "primitives.schema.json#/$defs/texte"
    },
    "status": {
      "$ref": "primitives.schema.json#/$defs/statut"
    },
    "version": {
      "$ref": "primitives.schema.json#/$defs/version"
    },
    "replacedBy": {
      "$ref": "primitives.schema.json#/$defs/stage"
    },
    "provenance": {
      "$ref": "primitives.schema.json#/$defs/provenance"
    },
    "evidence": {
      "$ref": "primitives.schema.json#/$defs/evidence"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "replacedBy": {}
        },
        "required": [
          "replacedBy"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "deprecated"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stageType": {
            "const": "cycle"
          }
        },
        "required": [
          "stageType"
        ]
      },
      "then": {
        "properties": {
          "code": {
            "enum": [
              "cycle-2",
              "cycle-3",
              "cycle-4"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "code": {
            "enum": [
              "seconde",
              "premiere",
              "terminale"
            ]
          }
        }
      }
    }
  ]
}
