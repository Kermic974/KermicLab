# Variables documentées sans valeur. Ne jamais committer de vraie valeur.
# Workers AI est fourni par le binding `AI` de worker/wrangler.toml (aucune clé API).
# Worker (secret de repli facultatif : `cd worker && npx wrangler secret put <NOM>`) — en local : worker/.dev.vars
LLM_SESSION_SECRET=     # secret aléatoire de 32 caractères minimum, signature des cookies de quota
ANTHROPIC_API_KEY=
AI_GATEWAY_TOKEN=       # secret AI Gateway Run, requis pour le repli Anthropic via kermiclab-gateway
GITHUB_TOKEN=            # jeton à droits limités : Issues (lecture/écriture) sur ce dépôt uniquement
COMPTES_LOCAUX_SECRET=   # compte local (ADR 0024) : 32 caractères aléatoires minimum, HMAC des identifiants et mots de passe ; ne jamais le changer

# Worker (variables non secrètes, dans worker/wrangler.toml [vars]) — registre, défauts et bornes :
# worker/src/configuration.js (ADR 0019), affichés en lecture seule dans l'écran Configuration.
# LLM_ACTIF=true        # arrêt d'urgence : false ; le catalogue reste accessible
# SKILLS_ACTIFS=tuteur,cadrage-idee,defi-express,constructeur-cahier (skills LLM actifs ; retirer un identifiant le coupe)
# TAILLE_MAX_MESSAGE=500 (50 à 2000)
# LIMITE_PAR_MINUTE=20 (1 à 120)
# MODELE_WORKERS_AI=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# MODELE_CHAT=claude-haiku-5-5 (repli Anthropic)
# LIMITE_TOKENS_SESSION=1000 (tokens générés par session, 200 à 4000)
# MAX_TOKENS_APPEL=500 (tokens par appel du tuteur, 100 à 1000)
# MODELE_DEFI=custom/haiku (alias de modèle AI Gateway du défi express, ADR 0018)
# DEFI_GENERATIONS_JOUR=3 (générations IA du défi express par session de 24 h, 0 à 10)
# MAX_TOKENS_DEFI=1500 (tokens par génération du défi, 500 à 3000)
# MODELE_CAHIERS=custom/sonnet-5-5 (alias de modèle AI Gateway de « Mes cahiers »)
# CAHIERS_GENERATIONS_JOUR=2 (cahiers enrichis par l'IA par session de 24 h, 0 à 5)
# MAX_TOKENS_CAHIERS=100000 (tokens par génération des cahiers, 1000 à 128000)
# GITHUB_REPO=kermic974/KermicLab
# ORIGINES_AUTORISEES=https://kermiclab.pages.dev

# Build du site statique
KERMICLAB_API_URL=       # URL publique du Worker (défaut en CI : https://kermiclab-api.kermic.workers.dev)

# GitHub Actions — Secrets : CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID, LLM_SESSION_SECRET, ANTHROPIC_API_KEY et AI_GATEWAY_TOKEN (repli facultatif),
#   KERMICLAB_GITHUB_TOKEN (jeton du Worker), CATALOGUE_TOKEN (lecture seule sur maquettes-catalogue)
# GitHub Actions — Variables : KERMICLAB_API_URL, CATALOGUE_REPO, CLOUDFLARE_PAGES_PROJECT
