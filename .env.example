# Variables documentées sans valeur. Ne jamais committer de vraie valeur.
# Worker (Cloudflare → Workers → trigolab → Settings → Variables and Secrets, ou `npx wrangler secret put <NOM>`)
# En local : copier ce fichier en .dev.vars à la racine.
ANTHROPIC_API_KEY=
GITHUB_TOKEN=            # jeton à droits limités : Issues (lecture/écriture) sur ce dépôt uniquement

# Worker (variables non secrètes, dans wrangler.toml [vars])
# MODELE_CHAT=claude-haiku-5-5
# GITHUB_REPO=kermic974/trigoLab
# ORIGINES_AUTORISEES=        # vide : chat et API sur la même origine
# TAILLE_MAX_MESSAGE=500
# LIMITE_PAR_MINUTE=20

# Build du site statique
KERMICLAB_API_URL=       # vide par défaut (même origine) ; seulement si l'API est servie ailleurs

# Déploiement : Cloudflare Workers Builds (dépôt relié au Worker trigolab), aucun jeton Cloudflare dans GitHub.
# GitHub Actions — Secrets (facultatifs) : ANTHROPIC_API_KEY (revue IA),
#   CATALOGUE_TOKEN (lecture seule sur maquettes-catalogue)
# GitHub Actions — Variables (facultatives) : CATALOGUE_REPO
