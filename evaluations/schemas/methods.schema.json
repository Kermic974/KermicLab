{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kermiclab.online/s7/methods.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["formatVersion", "methods"],
  "properties": {
    "formatVersion": { "const": 1 },
    "methods": {
      "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "version", "mode", "implementation", "sha256", "status"],
        "properties": {
          "id": { "$ref": "primitives.schema.json#/$defs/slug" },
          "version": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
          "mode": { "enum": ["deterministic", "assisted", "human"] },
          "implementation": { "type": "string", "pattern": "^web/evaluation-correction-v[1-9][0-9]*\\.js(?![\\s\\S])" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])" },
          "status": { "enum": ["supported", "deprecated"] }
        }
      }
    }
  }
}
